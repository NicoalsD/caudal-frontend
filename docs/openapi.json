{
  "openapi": "3.0.1",
  "info": {
    "title": "API de CAUDAL (instantánea mínima para el frontend)",
    "description": "Representa solo lo que el backend ya publica y el frontend usa hoy: el error canónico, la salud y los límites de campos. Se reemplaza por la instantánea completa de caudal-backend/docs/openapi.json cuando exista. Ver docs/tipos-de-la-api.md.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "paths": {
    "/actuator/health": {
      "get": {
        "operationId": "getHealth",
        "summary": "Salud mínima del servicio",
        "description": "Público. No revela detalles internos.",
        "responses": {
          "200": {
            "description": "El servicio responde.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          },
          "503": {
            "description": "El servicio no está disponible.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/meta/constraints": {
      "get": {
        "operationId": "getConstraints",
        "summary": "Límites de campos para armar los formularios",
        "description": "Público. Cada clave es un campo (por ejemplo reading.note) con sus límites tomados de FieldLimits en el backend.",
        "responses": {
          "200": {
            "description": "Mapa campo a límites.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConstraintsResponse"
                }
              }
            }
          },
          "429": {
            "description": "Demasiadas solicitudes (RATE_LIMITED).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Error no controlado (INTERNAL_ERROR).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "operationId": "login",
        "summary": "Inicia sesión",
        "description": "Público. Respuesta con el token de acceso y la cookie caudal_rt (HttpOnly) con el refresh. API.md sección 2.1.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Sesión iniciada.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            }
          },
          "401": {
            "description": "Usuario o contraseña incorrectos (INVALID_CREDENTIALS). Siempre el mismo mensaje.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Demasiados intentos (RATE_LIMITED).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/refresh": {
      "post": {
        "operationId": "refreshSession",
        "summary": "Renueva la sesión",
        "description": "Cookie caudal_rt válida, cabecera X-Requested-With: caudal-web y Origin permitido. Sin cuerpo. Rota la cookie. API.md sección 2.2.",
        "responses": {
          "200": {
            "description": "Token de acceso nuevo.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RefreshResponse"
                }
              }
            }
          },
          "401": {
            "description": "Sin cookie, vencida o reutilizada (UNAUTHORIZED, SESSION_REVOKED).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Falta X-Requested-With u Origin no permitido (FORBIDDEN).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "operationId": "logout",
        "summary": "Cierra la sesión",
        "description": "Autenticado. Revoca la familia del refresh y borra la cookie. API.md sección 2.3.",
        "responses": {
          "204": {
            "description": "Sesión cerrada."
          },
          "401": {
            "description": "Sesión no válida (UNAUTHORIZED).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/me": {
      "get": {
        "operationId": "getMe",
        "summary": "Datos de la persona autenticada",
        "description": "Permitido aunque must_change_password sea true. API.md sección 2.7.",
        "responses": {
          "200": {
            "description": "Persona, membresías y permisos.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            }
          },
          "401": {
            "description": "Sesión no válida (UNAUTHORIZED).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/change-password": {
      "post": {
        "operationId": "changePassword",
        "summary": "Cambia la contraseña",
        "description": "Autenticado. Permitido aunque must_change_password sea true. Revoca los refresh tokens (la sesión termina). API.md sección 2.5.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChangePasswordRequest"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Contraseña cambiada."
          },
          "401": {
            "description": "Contraseña actual incorrecta (UNAUTHORIZED).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "La contraseña no cumple la política (PASSWORD_POLICY_VIOLATION).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/switch-aqueduct": {
      "post": {
        "operationId": "switchAqueduct",
        "summary": "Cambia el acueducto activo",
        "description": "Autenticado. Un JWT lleva un solo acueducto. API.md sección 2.9.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SwitchAqueductRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Token de acceso del acueducto indicado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RefreshResponse"
                }
              }
            }
          },
          "403": {
            "description": "La membresía no está vigente o no existe (FORBIDDEN).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ErrorBody": {
        "type": "object",
        "required": [
          "code",
          "message",
          "request_id"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "Código en SCREAMING_SNAKE_CASE del catálogo de API.md sección 1.4.",
            "example": "GAUGE_OUT_OF_RANGE"
          },
          "message": {
            "type": "string",
            "description": "Mensaje en español. Sirve de respaldo; la UI usa el texto de es.ts."
          },
          "details": {
            "type": "object",
            "additionalProperties": true,
            "description": "Objeto opcional con datos del error. Sin trazas ni secretos."
          },
          "request_id": {
            "type": "string",
            "description": "Correlaciona la respuesta con los registros. También viene en X-Request-Id."
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        }
      },
      "HealthResponse": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "UP",
              "DOWN"
            ]
          }
        }
      },
      "FieldConstraint": {
        "type": "object",
        "description": "Límites de un campo. Todos son opcionales: solo llegan los que aplican.",
        "properties": {
          "min": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "max": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "pattern": {
            "type": "string",
            "description": "Expresión regular compatible con JavaScript (bandera u)."
          },
          "max_lines": {
            "type": "integer",
            "format": "int32",
            "minimum": 1
          }
        }
      },
      "ConstraintsResponse": {
        "type": "object",
        "description": "Mapa plano de nombre de campo a límites (API.md sección 4.1).",
        "additionalProperties": {
          "$ref": "#/components/schemas/FieldConstraint"
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "properties": {
          "username": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "AuthUser": {
        "type": "object",
        "required": [
          "id",
          "username",
          "full_name",
          "role",
          "aqueduct_id",
          "must_change_password"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "username": {
            "type": "string"
          },
          "full_name": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "BOARD_ADMIN",
              "BOARD_MEMBER",
              "OPERATOR",
              "PROJECT_TEAM",
              "SUPPORT_ENTITY"
            ]
          },
          "aqueduct_id": {
            "type": "string",
            "format": "uuid"
          },
          "must_change_password": {
            "type": "boolean"
          }
        }
      },
      "LoginResponse": {
        "type": "object",
        "required": [
          "access_token",
          "token_type",
          "expires_in",
          "user"
        ],
        "properties": {
          "access_token": {
            "type": "string"
          },
          "token_type": {
            "type": "string",
            "enum": [
              "Bearer"
            ]
          },
          "expires_in": {
            "type": "integer",
            "format": "int32",
            "description": "Segundos de vida del token de acceso."
          },
          "user": {
            "$ref": "#/components/schemas/AuthUser"
          }
        }
      },
      "RefreshResponse": {
        "type": "object",
        "required": [
          "access_token",
          "expires_in"
        ],
        "properties": {
          "access_token": {
            "type": "string"
          },
          "token_type": {
            "type": "string",
            "enum": [
              "Bearer"
            ]
          },
          "expires_in": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "Membership": {
        "type": "object",
        "required": [
          "aqueduct_id",
          "role"
        ],
        "properties": {
          "aqueduct_id": {
            "type": "string",
            "format": "uuid"
          },
          "role": {
            "type": "string",
            "enum": [
              "BOARD_ADMIN",
              "BOARD_MEMBER",
              "OPERATOR",
              "PROJECT_TEAM",
              "SUPPORT_ENTITY"
            ]
          },
          "valid_from": {
            "type": "string",
            "format": "date-time"
          },
          "valid_to": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        }
      },
      "MeResponse": {
        "type": "object",
        "required": [
          "id",
          "username",
          "full_name",
          "must_change_password",
          "memberships",
          "permissions"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "username": {
            "type": "string"
          },
          "full_name": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "must_change_password": {
            "type": "boolean"
          },
          "privacy_accepted_version": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "memberships": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Membership"
            }
          },
          "permissions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Códigos de permiso (por ejemplo RULESET_ACTIVATE). El cliente los usa solo para mostrar u ocultar acciones."
          }
        }
      },
      "ChangePasswordRequest": {
        "type": "object",
        "required": [
          "current_password",
          "new_password"
        ],
        "properties": {
          "current_password": {
            "type": "string"
          },
          "new_password": {
            "type": "string"
          }
        }
      },
      "SwitchAqueductRequest": {
        "type": "object",
        "required": [
          "aqueduct_id"
        ],
        "properties": {
          "aqueduct_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      }
    }
  }
}
